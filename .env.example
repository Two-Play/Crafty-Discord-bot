# Required
SERVER_URL=
DISCORD_TOKEN=
CRAFTY_TOKEN=

# Optional
GUILD_ID=
ENABLE_AUTO_STOP_SERVER=
# Time in seconds (default 1800 seconds = 30 minutes)
AUTO_STOP_SLEEP_TIME=
# Verify the TLS certificate of Crafty (default false, Crafty uses a self-signed certificate)
CRAFTY_VERIFY_SSL=
# DEBUG, INFO (default), WARNING or ERROR (DEBUG only applies to the bot, libraries stay at INFO)
LOG_LEVEL=
# Also write the log to this file (rotated at 5 MB, 3 old files are kept)
LOG_FILE=

# Read-only web dashboard with the bot and server status
WEB_ENABLED=
# Interface to listen on (default 127.0.0.1, use 0.0.0.0 to reach it from other machines)
WEB_HOST=
# Default 8080
WEB_PORT=
# Password for the dashboard (HTTP basic auth, any user name). Strongly recommended if reachable from outside.
WEB_PASSWORD=

# Login with username and password instead of CRAFTY_TOKEN. Not recommended. (optional)
CRAFTY_USERNAME=
CRAFTY_PASSWORD=
